# Mimir analytics configuration.
#
# Local dev: the script URL + endpoint are already set in the committed
# .env.development; you only need the ingest token below in a .env.local
# (gitignored). Production: set all four as repository variables/secrets
# consumed by .github/workflows/deploy.yml. When the token, script URL,
# or endpoint is missing, the app builds and runs with no analytics.

# Ingest token for the `tectonic` project in your Mimir instance.
VITE_MIMIR_TOKEN=

# Where the Mimir SDK script is loaded from.
#   dev  — /_m/script.js  (Vite proxies it to https://mimir.test/mimir.js)
#   prod — https://<your-public-mimir-host>/mimir.js
VITE_MIMIR_SCRIPT_URL=

# Where Mimir events are POSTed.
#   dev  — /_m/api/ingest
#   prod — https://<your-public-mimir-host>/api/ingest
VITE_MIMIR_ENDPOINT=

# App version tagged on every event. The deploy sets this to the commit SHA.
VITE_MIMIR_APP_VERSION=

# Profile sync — the Cloudflare Worker + KV backend (ADR-0020, supersedes
# ADR-0013). Tectonic is single-user and local-first; sync mirrors the
# one profile so it follows the user across devices.
#
# VITE_SYNC_URL    — the deployed Worker origin, no trailing slash
#                    (e.g. https://tectonic-sync.<subdomain>.workers.dev).
#                    The client calls ${VITE_SYNC_URL}/profile.
# VITE_SYNC_SECRET — the bearer secret; the same string passed to the
#                    Worker via `wrangler secret put SYNC_SECRET`.
#
# Put both in a .env.local (gitignored) for dev, and in the deploy
# variables/secrets for production. When either is missing, the app
# builds and runs fully local-only — sync is simply absent.
#
# The secret ships in the client bundle. That is acceptable here: one
# user, low stakes (it guards a single profile blob). See ADR-0020 and
# sync-worker/README.md.
VITE_SYNC_URL=
VITE_SYNC_SECRET=
